{
  "$schema_version": "0.1",
  "form_id": "leave_request_v1",
  "title": "請假申請（紙本風）",
  "layout": {
    "style": "paper_text",
    "columns_per_row": 2,
    "show_design_preview": true
  },
  "fields": [
    {
      "name": "applicant",
      "display_name": "申請人",
      "type": "person",
      "required": true,
      "editable_by": ["applicant"],
      "visible_to": ["applicant", "approver", "agent"],
      "storage": "shared",
      "sensitivity": "open",
      "readonly_when": ["status != draft"]
    },
    {
      "name": "leave_type",
      "display_name": "假別",
      "type": "dropdown",
      "options": ["特休", "事假", "病假", "其他"],
      "required": true,
      "editable_by": ["applicant"],
      "visible_to": ["applicant", "approver", "agent"],
      "storage": "shared",
      "sensitivity": "open"
    },
    {
      "name": "days",
      "display_name": "天數",
      "type": "number",
      "required": true,
      "editable_by": ["applicant"],
      "visible_to": ["applicant", "approver", "agent"],
      "storage": "shared",
      "sensitivity": "open",
      "required_when": "leave_type != null"
    },
    {
      "name": "need_cover",
      "display_name": "是否需代理人",
      "type": "yes_no",
      "required": true,
      "editable_by": ["applicant"],
      "visible_to": ["applicant", "approver", "agent"],
      "storage": "shared",
      "sensitivity": "open"
    },
    {
      "name": "agent",
      "display_name": "代理人",
      "type": "person",
      "required": false,
      "required_when": "need_cover == yes",
      "visible_when": "need_cover == yes",
      "editable_by": ["applicant"],
      "visible_to": ["applicant", "approver", "agent"],
      "storage": "shared",
      "sensitivity": "open"
    },
    {
      "name": "private_note",
      "display_name": "僅自己可見備註",
      "type": "text",
      "required": false,
      "editable_by": ["owner"],
      "visible_to": ["owner"],
      "storage": "personal",
      "sensitivity": "locked",
      "note": "不寫入共用清單；依登入者 ID 從個人儲存空間讀出後填入畫面；對 Agent 預設同字數〇 遮罩"
    },
    {
      "name": "sales_amount_example",
      "display_name": "業績金額（機敏範例）",
      "type": "number",
      "required": false,
      "editable_by": ["owner"],
      "visible_to": ["owner"],
      "storage": "personal",
      "sensitivity": "locked",
      "note": "示範：Agent 未解鎖時見同位數 9（例 1280000→9999999）"
    }
  ],
  "actions": ["submit", "approve", "deny", "return", "notify_request"],
  "signature_line": {
    "style": "waterline",
    "nodes": [
      { "role": "applicant", "label": "申請人", "click": ["change_agent", "view_profile"] },
      { "role": "agent", "label": "代理人", "click": ["change_agent", "view_profile"] },
      { "role": "approver", "label": "簽核人", "click": ["change_approver", "return", "notify_request", "view_profile"] }
    ]
  },
  "conversation": {
    "style": "line_boxes",
    "bound_fields_mode": "whitelist",
    "default_bound_fields": ["leave_type", "days"],
    "each_message_is_box": true,
    "reply_creates_new_box": true
  },
  "privacy": {
    "identity_key": "user_id",
    "shared_store": "sharepoint_list",
    "personal_store": "user_personal_space",
    "rule": "畫面只渲染 visible_to 含目前登入者的欄位；personal 欄位內容不存在於共用應用資料，僅依 ID 即時讀取",
    "agent_mask": {
      "when": "sensitivity == locked 且尚未解鎖",
      "mode": "element_isomorphic",
      "purpose": "假資料供 Agent／匯出定長取值測試；元素類別與位元組長度必須與明文相同",
      "rules": {
        "halfwidth_digit": "0-9 → 9",
        "fullwidth_digit": "０-９ → ９",
        "latin_letter": "A-Z → X；a-z → x",
        "cjk_or_wide_letter": "→ 〇（若匯出編碼下 byte 數不合則換同寬字）",
        "symbol_space_punct": "原樣保留（含 - / . 空白 換行）"
      },
      "length": {
        "char_count": "必須相等",
        "byte_length": "在 export_encoding 下必須相等（定長／位元組偏移取值）"
      },
      "export_encoding": "utf-8",
      "examples": [
        { "in": "1280000", "out": "9999999" },
        { "in": "0912-345-678", "out": "9999-999-999" },
        { "in": "王小明", "out": "〇〇〇" },
        { "in": "A12-中文", "out": "X99-〇〇" }
      ],
      "unlock": "待定：A 本機核准／B 雙人／C 時段"
    }
  }
}
