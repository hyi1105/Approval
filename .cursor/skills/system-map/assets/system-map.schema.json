{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyi1105.github.io/Approval/schema/system-map/system-map.schema.json",
  "title": "SystemMap",
  "type": "object",
  "required": ["map_version", "system", "tables", "roles", "story"],
  "additionalProperties": false,
  "properties": {
    "map_version": { "type": "string", "description": "地圖格式版本，例如 0.1" },
    "system": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "summary": { "type": "string" },
        "stores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "label"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "kind": {
                "type": "string",
                "enum": ["postgres", "sharepoint", "onedrive", "api", "file", "other"]
              },
              "label": { "type": "string" },
              "url": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "story": {
      "type": "object",
      "required": ["trigger", "steps"],
      "additionalProperties": false,
      "properties": {
        "trigger": { "type": "string" },
        "background": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "actor"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "actor": { "type": "string" },
              "action": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "store", "fields"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "store": { "type": "string", "description": "對應 system.stores[].id" },
          "notes": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "type", "required", "source"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "source": {
                  "type": "object",
                  "required": ["kind"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "auto",
                        "manual",
                        "lookup",
                        "api_sync",
                        "computed",
                        "derived_permission"
                      ]
                    },
                    "from": {
                      "type": "string",
                      "description": "來源表.欄 或系統名，例如 personnel.department"
                    },
                    "condition": { "type": "string" },
                    "formula": { "type": "string" },
                    "notes": { "type": "string" }
                  }
                },
                "filled_by": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "visible_to": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "editable_by": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "consumed_by": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "step_matrix": {
                  "type": "array",
                  "description": "依流程步驟的可見／可編／必填",
                  "items": {
                    "type": "object",
                    "required": ["step", "role"],
                    "additionalProperties": false,
                    "properties": {
                      "step": { "type": "string" },
                      "role": { "type": "string" },
                      "visible": { "type": "boolean" },
                      "editable": { "type": "boolean" },
                      "must_fill": { "type": "boolean" }
                    }
                  }
                },
                "attributes": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "via"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "via": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "one_liner": {
      "type": "string",
      "description": "給完全不懂的人的白話一句"
    }
  }
}
