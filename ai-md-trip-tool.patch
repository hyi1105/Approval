+    transition: transform 0.25s ease;
+    box-shadow: var(--shadow);
+  }
+  .sidebar.open { transform: translateX(0); }
+  .fab-toggle { display: grid; place-items: center; }
+  .map-stats { right: 66px; left: 12px; min-width: 0; }
+  .sidebar-actions { grid-template-columns: 1fr 1fr; }
+  .sidebar-actions #btnAddStop,
+  .sidebar-actions #btnPasteItinerary { grid-column: 1 / -1; }
+}
